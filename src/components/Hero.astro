---
interface Props {
  headline: string;
}

const { headline } = Astro.props;
---

<section class="px-4 pt-16 pb-6 md:px-6 md:pt-28">
  {
    headline && (
      <h1 class="font-display text-8xl leading-[0.8] tracking-tight md:text-[10rem]">
        {headline}
      </h1>
    )
  }
  <slot />
</section>
