---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// Ignore a leading "The " so "The Beatles" sorts under B.
const sortKey = (s: string) => s.replace(/^the\s+/i, "");

const records = (await getCollection("records")).sort(
  (a, b) =>
    sortKey(a.data.artist).localeCompare(sortKey(b.data.artist)) ||
    a.data.title.localeCompare(b.data.title),
);

const genres = [...new Set(records.flatMap((r) => r.data.genres))].sort();
const decades = [
  ...new Set(records.filter((r) => r.data.year).map((r) => Math.floor(r.data.year! / 10) * 10)),
].sort();
---

<div class="my-6 flex flex-wrap gap-3">
  <input id="search" type="search" placeholder="Search artist or title" class="border px-3 py-2 rounded grow" />
  <select id="genre" class="border px-3 py-2 rounded">
    <option value="">All genres</option>
    {genres.map((g) => <option value={g}>{g}</option>)}
  </select>
  <select id="sort" class="border px-3 py-2 rounded" aria-label="Sort by">
    <option value="artist">Artist (A–Z)</option>
    <option value="title">Title (A–Z)</option>
    <option value="year-desc">Year (newest first)</option>
    <option value="year-asc">Year (oldest first)</option>
  </select>
  <select id="decade" class="border px-3 py-2 rounded">
    <option value="">All decades</option>
    {decades.map((d) => <option value={d}>{d}s</option>)}
  </select>
</div>

<div class="mb-4 flex items-center gap-4 text-sm">
  <p id="count" aria-live="polite"></p>
  <button type="button" id="clear" class="underline" hidden>Clear filters</button>
</div>

<p id="empty" class="my-8 text-center" hidden>
  No records match your filters.
  <button type="button" id="clear-empty" class="underline">Clear filters</button>
</p>

<ul class="grid grid-cols-2 gap-6 md:grid-cols-4" id="grid">
  {
    records.map(({ data }) => (
      <li
        data-search={`${data.artist} ${data.title}`.toLowerCase()}
        data-genres={data.genres.join("|")}
        data-artist={sortKey(data.artist).toLowerCase()}
        data-title={data.title.toLowerCase()}
        data-year={data.year ?? ""}
        data-decade={data.year ? Math.floor(data.year / 10) * 10 : ""}
      >
        {data.cover ? (
          <Image src={data.cover} alt={`${data.title} by ${data.artist}`} width={400} height={400} class="aspect-square w-full object-cover" />
        ) : (
          <div class="aspect-square w-full bg-neutral-200 flex items-center justify-center text-sm p-2 text-center">
            No cover
          </div>
        )}
        <p class="mt-2 font-semibold">{data.title}</p>
        <p class="text-sm">{data.artist}{data.year ? ` · ${data.year}` : ""}</p>
        {data.variant && <p class="text-xs text-neutral-500">{data.variant}</p>}
      </li>
    ))
  }
</ul>

<script>
  const search = document.querySelector<HTMLInputElement>("#search")!;
  const genre = document.querySelector<HTMLSelectElement>("#genre")!;
  const decade = document.querySelector<HTMLSelectElement>("#decade")!;
  const sort = document.querySelector<HTMLSelectElement>("#sort")!;
  const grid = document.querySelector<HTMLElement>("#grid")!;
  const clear = document.querySelector<HTMLButtonElement>("#clear")!;
  const clearEmpty = document.querySelector<HTMLButtonElement>("#clear-empty")!;
  const empty = document.querySelector<HTMLElement>("#empty")!;
  const count = document.querySelector<HTMLElement>("#count")!;
  const items = [...document.querySelectorAll<HTMLElement>("#grid > li")];

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const match =
        (!q || li.dataset.search!.includes(q)) &&
        (!genre.value || li.dataset.genres!.split("|").includes(genre.value)) &&
        (!decade.value || li.dataset.decade === decade.value);
      li.hidden = !match;
      if (match) shown++;
    }
    clear.hidden = !(q || genre.value || decade.value);
    empty.hidden = shown > 0;
    count.textContent = `${shown} of ${items.length} records`;
  }

  const text = (li: HTMLElement, key: "artist" | "title") => li.dataset[key] ?? "";
  const byArtist = (a: HTMLElement, b: HTMLElement) =>
    text(a, "artist").localeCompare(text(b, "artist")) || text(a, "title").localeCompare(text(b, "title"));

  // Records without a year always sort last.
  const byYear = (dir: 1 | -1) => (a: HTMLElement, b: HTMLElement) => {
    const ya = a.dataset.year ? Number(a.dataset.year) : null;
    const yb = b.dataset.year ? Number(b.dataset.year) : null;
    if (ya === null && yb === null) return byArtist(a, b);
    if (ya === null) return 1;
    if (yb === null) return -1;
    return (ya - yb) * dir || byArtist(a, b);
  };

  function applySort() {
    const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      artist: byArtist,
      title: (a, b) => text(a, "title").localeCompare(text(b, "title")) || byArtist(a, b),
      "year-desc": byYear(-1),
      "year-asc": byYear(1),
    };
    grid.append(...[...items].sort(sorters[sort.value]));
  }

  [search, genre, decade].forEach((el) => el.addEventListener("input", apply));
  sort.addEventListener("input", applySort);
  function resetFilters() {
    search.value = "";
    genre.value = "";
    decade.value = "";
    apply();
    search.focus();
  }
  clear.addEventListener("click", resetFilters);
  clearEmpty.addEventListener("click", resetFilters);
  apply();
</script>
