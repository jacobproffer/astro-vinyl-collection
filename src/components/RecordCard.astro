---
import type { CollectionEntry } from "astro:content";
import VinylSleeve from "./VinylSleeve.astro";
import { decadeOf, sortKey } from "../lib/vinyl";

interface Props {
  record: CollectionEntry<"records">["data"];
  index: number;
}

const { record, index } = Astro.props;
---

<li
  class="group flex flex-col overflow-hidden border-r border-b border-black p-4 transition-colors duration-150 hover:bg-black hover:text-white md:p-6"
  data-search={`${record.artist} ${record.title}`.toLowerCase()}
  data-genres={record.genres.join("|")}
  data-artist={sortKey(record.artist).toLowerCase()}
  data-title={record.title.toLowerCase()}
  data-year={record.year ?? ""}
  data-decade={decadeOf(record.year) ?? ""}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3
        class="text-2xl leading-tight font-medium tracking-tight text-balance"
      >
        {record.title.trim()}
      </h3>
      <p class="mt-1 font-mono text-xs uppercase">{record.artist}</p>
    </div>
    <span class="shrink-0 font-mono text-xs">
      №{String(index + 1).padStart(3, "0")}
    </span>
  </div>

  <VinylSleeve
    cover={record.cover}
    alt={`${record.title} by ${record.artist}`}
    variant={record.variant}
    priority={index < 3}
  />

  <div
    class="mt-auto flex items-end justify-between gap-4 font-mono text-xs leading-snug uppercase"
  >
    <ul>
      {record.label && <li>{record.label}</li>}
      {record.variant && <li>{record.variant}</li>}
      <li>
        {[record.format, ...record.descriptions].filter(Boolean).join(" / ")}
      </li>
      {record.genres.length > 0 && <li>{record.genres.join(", ")}</li>}
    </ul>
    <span class="shrink-0 text-sm">{record.year ?? "—"}</span>
  </div>
</li>
