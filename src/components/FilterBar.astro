---
import FilterSelect from "./FilterSelect.astro";

interface Props {
  genres: string[];
  decades: number[];
}

const { genres, decades } = Astro.props;
---

<div
  class="sticky top-0 z-20 flex flex-wrap border-b border-black bg-white font-mono text-xs uppercase"
>
  <label for="search" class="sr-only">Search artist or title</label>
  <input
    id="search"
    type="search"
    placeholder="Search artist or title"
    class="min-w-48 grow rounded-none border-r border-black bg-transparent px-4 py-3 placeholder:text-neutral-500 placeholder:uppercase focus:bg-black focus:text-white focus:outline-none md:px-6"
  />
  <FilterSelect
    id="genre"
    label="Filter by genre"
    options={[
      { value: "", label: "All genres" },
      ...genres.map((g) => ({ value: g, label: g })),
    ]}
  />
  <FilterSelect
    id="sort"
    label="Sort by"
    options={[
      { value: "artist", label: "Artist (A–Z)" },
      { value: "title", label: "Title (A–Z)" },
      { value: "year-desc", label: "Year (newest first)" },
      { value: "year-asc", label: "Year (oldest first)" },
    ]}
  />
  <FilterSelect
    id="decade"
    label="Filter by decade"
    last
    options={[
      { value: "", label: "All decades" },
      ...decades.map((d) => ({ value: d, label: `${d}s` })),
    ]}
  />
</div>
