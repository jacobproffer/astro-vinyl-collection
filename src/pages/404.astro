---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
const pageTitle = "Page not found | Vinyl Collection";
---

<BaseLayout pageTitle={pageTitle}>
  <Hero headline="Page not found">
    <p class="mt-6 max-w-prose font-mono text-xs uppercase">
      The page you’re looking for doesn’t exist or may have moved.
    </p>
    <a class="mt-4 inline-block font-mono text-xs uppercase underline" href="/#records">
      Browse the collection
    </a>
  </Hero>
</BaseLayout>
